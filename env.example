# --- Banco de dados ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=seu_usuario_mysql
DB_PASSWORD=sua_senha_mysql
DB_NAME=imobiliaria_lar_ideal_db

# SSL: deixe em branco no MySQL local. Em banco na nuvem use DB_SSL=true
# ou DB_SSL_CA=certs/ca.pem (certificado baixado do provedor, ex.: Aiven).
DB_SSL=
DB_SSL_CA=

# Gere uma chave com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria
